{
  "name": "ghx-tool",
  "version": "2.1.3",
  "description": "GitHub Account Manager CLI",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/purshottam-jain24/ghx.git"
  },
  "homepage": "https://github.com/purshottam-jain24/ghx#readme",
  "bugs": {
    "url": "https://github.com/purshottam-jain24/ghx/issues"
  },
  "main": "bin/ghx.js",
  "bin": {
    "ghx": "bin/ghx.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/**",
    "lint:fix": "eslint src/** --fix",
    "format": "prettier --write src/**",
    "build": "node scripts/build-binaries.js",
    "build:binaries": "node scripts/build-binaries.js",
    "desktop": "electron desktop/main.js",
    "desktop:dist": "electron-builder --publish never",
    "check:version": "node scripts/check-version.js",
    "release": "release-it"
  },
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": [
      "package.json"
    ],
    "outputPath": "dist"
  },
  "build": {
    "appId": "com.purshottamjain.ghx",
    "productName": "GHX",
    "copyright": "Copyright © 2026 Purshottam Jain",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "src/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "artifactName": "GHX-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "GHX-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "GHX-Setup-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Purshottam Jain <purshottam-jain24@users.noreply.github.com>",
      "synopsis": "GitHub multi-account manager"
    },
    "publish": null
  },
  "keywords": [
    "github",
    "cli",
    "multi-account",
    "ssh"
  ],
  "author": "Purshottam Jain",
  "license": "Proprietary",
  "dependencies": {
    "chalk": "^4.1.2",
    "clipboardy": "^5.0.2",
    "commander": "^11.0.0",
    "console-table-printer": "^2.15.0",
    "fs-extra": "^11.1.0",
    "inquirer": "^8.2.5",
    "ora": "^5.4.1",
    "simple-git": "^3.19.0"
  },
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@release-it/conventional-changelog": "^10.0.4",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "pkg": "^5.8.1",
    "prettier": "^3.7.4",
    "release-it": "^19.2.2"
  }
}
